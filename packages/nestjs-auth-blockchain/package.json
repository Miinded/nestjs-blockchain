{
  "name": "@miinded/nestjs-auth-blockchain",
  "version": "1.0.1",
  "description": "Production-ready NestJS module for blockchain-based authentication. Supports Web3 signature verification with JWT tokens.",
  "license": "MIT",
  "author": "Miinded",
  "repository": {
    "type": "git",
    "url": "https://github.com/Miinded/nestjs-blockchain.git",
    "directory": "packages/nestjs-auth-blockchain"
  },
  "bugs": {
    "url": "https://github.com/Miinded/nestjs-blockchain/issues"
  },
  "homepage": "https://github.com/Miinded/nestjs-blockchain/tree/main/packages/nestjs-auth-blockchain",
  "keywords": [
    "nestjs",
    "nest",
    "web3",
    "ethereum",
    "authentication",
    "blockchain",
    "jwt",
    "signature",
    "siwe",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm clean",
    "build": "tsc --project tsconfig.cjs.json && tsc --project tsconfig.esm.json",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "pnpm test:unit && pnpm test:int && pnpm test:e2e",
    "test:unit": "node ../../config/run-jest.mjs unit",
    "test:unit:debug": "node ../../config/run-jest.mjs unit:debug",
    "test:int": "node ../../config/run-jest.mjs int",
    "test:int:debug": "node ../../config/run-jest.mjs int:debug",
    "test:e2e": "node ../../config/run-jest.mjs e2e",
    "test:e2e:debug": "node ../../config/run-jest.mjs e2e:debug",
    "test:debug": "node ../../config/run-jest.mjs debug",
    "test:watch": "node ../../config/run-jest.mjs watch",
    "test:coverage": "node ../../config/run-jest.mjs coverage"
  },
  "dependencies": {
    "@miinded/nestjs-blockchain-core": "workspace:^",
    "@miinded/nestjs-web3-signature": "workspace:^",
    "@metamask/eth-sig-util": "^8.2.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.3.0 || ^11.0.0",
    "@nestjs/core": "^10.3.0 || ^11.0.0",
    "@nestjs/jwt": "^10.3.0 || ^11.0.0",
    "@nestjs/passport": "^10.0.0 || ^11.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-strategy": "^1.0.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/passport": "catalog:",
    "@types/passport-jwt": "catalog:",
    "@types/passport-strategy": "catalog:",
    "@types/supertest": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "jest": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "passport-strategy": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "rxjs": "catalog:",
    "supertest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  }
}
